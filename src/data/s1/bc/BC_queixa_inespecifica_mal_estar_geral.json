  "routing_rules": [
    {
      "pattern": "mal-estar + febre predominante",
      "route": "febre / síndrome febril"
    },
    {
      "pattern": "mal-estar + dispneia predominante",
      "route": "dispneia / dificuldade respiratória"
    },
    {
      "pattern": "mal-estar + tontura",
      "route": "vertigem / tontura / desequilíbrio"
    },
    {
      "pattern": "mal-estar + palpitações",
      "route": "palpitações / alteração do ritmo cardíaco"
    },
    {
      "pattern": "mal-estar + dor",
      "route": "algoritmo específico da dor conforme localização"
    },
    {
      "pattern": "fraqueza unilateral",
      "route": "déficit neurológico focal"
    },
    {
      "pattern": "fraqueza + sensação de desmaio",
      "route": "diferenciar fraqueza / pré-síncope / síncope"
    },
    {
      "pattern": "sonolência ou confusão",
      "route": "alteração do nível de consciência / estado mental"
    }
  ],
  "error_prevention_rules": [
    "preservar termos originais",
    "não assumir equivalência entre sintomas vagos",
    "não corrigir contradições silenciosamente",
    "não atribuir precisão temporal inexistente",
    "não estabelecer causalidade apenas por coexistência temporal",
    "não manter manifestação específica relevante agrupada apenas como mal-estar",
    "não gerar perguntas sobre itens já adequadamente documentados",
    "priorizar ganho informacional por pergunta"
