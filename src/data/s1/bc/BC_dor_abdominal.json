      {
        "id":"A08",
        "if":"diarrhea_present AND blood_or_mucus_status_missing",
        "severity":"medium",
        "message":"Diarreia presente sem caracterizacao de sangue/muco quando clinicamente pertinente."
      },
      {
        "id":"A09",
        "if":"reproductive_context_present AND pregnancy_status_relevant_but_missing",
        "severity":"high",
        "message":"Contexto gineco-obstetrico potencialmente relevante sem informacao suficiente sobre gestacao/DUM."
      },
      {
        "id":"A10",
        "if":"medication_used AND response_missing",
        "severity":"low",
        "message":"Medicamento utilizado sem resposta clinica documentada."
      },
      {
        "id":"A11",
        "if":"same_concept_positive_and_negated",
        "severity":"high",
        "message":"INFORMACAO CONTRADITORIA — requer esclarecimento."
      }
    ]
