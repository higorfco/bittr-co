{
  "metadata": {
    "id": "qd_hma_dispneia_dificuldade_respiratoria",
    "version": "1.0.0",
    "language": "pt-BR",
    "scope": [
      "Queixa e Duração (QD)",
      "História da Moléstia Atual (HMA/HPMA)"
    ],
    "chief_complaint": [
      "dispneia",
      "dificuldade respiratória"
    ],
    "purpose": [
      "extrair informações clínicas explicitamente documentadas",
      "normalizar terminologia relevante",
      "identificar informações ausentes, vagas, incompletas ou contraditórias",
      "reconhecer negativas pertinentes",
      "priorizar lacunas clínicas de forma tempo-efetiva",
      "apoiar análise crítica da qualidade do registro",
      "reduzir erros de interpretação sem realizar diagnóstico"
    ],
    "prohibited_actions": [
      "diagnosticar",
      "definir tratamento",
      "solicitar exames",
      "inferir informações não presentes no texto",
      "interpretar ausência de menção como negativa"
    ]
  },
  "core_rules": {
    "negation": "NEGADO != NAO_INFORMADO",
    "no_inference": true,
    "source_fidelity": "preservar o significado do texto original; normalização sem inventar conteúdo",
    "temporal_missing_rule": "se a temporalidade não puder ser determinada, classificar como AUSENTE_NAO_INFORMADO",
    "orthopnea_rule": "não assumir ortopneia apenas por dispneia noturna ou menção isolada a dormir mal",
    "pnd_rule": "não assumir dispneia paroxística noturna apenas por dispneia durante a noite",
    "ambiguity_rule": "cansaço, fadiga e fraqueza não equivalem automaticamente a dispneia",
    "time_efficiency": "priorizar o menor número de perguntas com maior ganho informacional e impacto em segurança"
  },
  "information_status": {
    "PRESENTE_E_CLARO": "informação explícita e suficientemente caracterizada",
    "PRESENTE_MAS_INCOMPLETO": "informação presente, porém necessita detalhamento",
    "AUSENTE_NAO_INFORMADO": "não consta no texto",
    "AMBIGUO_VAGO": "linguagem insuficientemente precisa ou semanticamente incerta",
    "CONTRADITORIO": "há informações incompatíveis entre si",
    "NAO_APLICAVEL": "não pertinente ao contexto, quando justificável"
  },
  "priority": {
    "CRITICA": "ausência pode prejudicar significativamente a avaliação inicial de segurança",
    "IMPORTANTE": "necessária para caracterização adequada da queixa",
    "COMPLEMENTAR": "melhora a qualidade do registro, com menor prioridade imediata"
  },
