  "status_model": {
    "allowed": [
      "PRESENTE",
      "NEGADA",
      "AUSENTE",
      "VAGA",
      "CONTRADITORIA",
      "NAO_APLICAVEL"
    ],
    "rule": "Informação não mencionada nunca deve ser classificada automaticamente como NEGADA."
  },
  "priority_model": {
    "allowed": [
      "CRITICA",
      "IMPORTANTE",
      "COMPLEMENTAR"
    ]
  },
  "safety_features": [
    "sudden_onset",
    "maximal_at_onset",
    "exertional_pain",
    "oppressive_quality",
    "syncope",
    "significant_dyspnea",
    "diaphoresis",
    "hemoptysis",
    "neurologic_symptoms",
    "radiation_to_back",
    "hemodynamic_instability"
  ],
  "audit_rules": [
    {
      "id": "R001",
      "if": [
        "chest_pain=true",
        "onset=missing"
      ],
      "then": [
        "flag=CRITICAL_MISSING"
      ]
    },
    {
      "id": "R002",
      "if": [
        "chest_pain=true",
        "location=missing"
      ],
      "then": [
        "flag=CRITICAL_MISSING"
      ]
    },
    {
      "id": "R003",
      "if": [
        "chest_pain=true",
        "current_status=missing"
      ],
      "then": [
        "flag=CRITICAL_MISSING"
      ]
    },
    {
      "id": "R004",
      "if": [
        "sudden_onset=true",
        "maximal_at_onset=missing"
      ],
      "then": [
        "ask=A dor atingiu intensidade máxima imediatamente?"
      ]
    },
    {
      "id": "R005",
      "if": [
        "exertional_relation=missing"
      ],
      "then": [
        "flag=IMPORTANT_MISSING"
      ]
    },
    {
      "id": "R006",
      "if": [
        "symptom=mentioned",
        "negation_scope(symptom)=true"
      ],
      "then": [
        "status=NEGADA"
      ]
    },
    {
      "id": "R007",
      "if": [
        "symptom=not_mentioned"
      ],
      "then": [
        "status=AUSENTE"
      ],
      "prohibited": [
        "status=NEGADA"
      ]
    },
    {
      "id": "R008",
      "if": [
        "pain_quality=pleuritic"
      ],
      "then": [
        "normalize=relation_with_breathing"
      ]
    },
    {
      "id": "R009",
      "if": [
        "pattern=dor N/10"
      ],
      "then": [
        "extract=severity",
        "scale=10"
      ]
    },
    {
      "id": "R010",
      "if": [
        "duration_expression=present"
      ],
      "then": [
        "extract=value",
        "extract=unit"
      ]
    },
    {
      "id": "R011",
      "if": [
        "conflicting_statements=true"
      ],
      "then": [
        "status=CONTRADITORIA",
        "preserve_both_statements=true"
      ]
    }
  ],
  "analysis_pipeline": [
    "normalizacao_textual",
    "identificacao_de_conceitos",
    "deteccao_de_negacao",
