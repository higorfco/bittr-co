  "ambiguity_rules": [
    {
      "pattern": "tontura isolada",
      "flag": "fenômeno não caracterizado"
    },
    {
      "pattern": "vertigem + sensação de desmaio tratadas como equivalentes",
      "flag": "fenômenos distintos potencialmente misturados"
    },
    {
      "pattern": "contínuo + episódico sem explicação",
      "flag": "padrão temporal contraditório/ambíguo"
    },
    {
      "pattern": "súbito + progressivo sem sequência",
      "flag": "modo de início ambíguo"
    },
    {
      "pattern": "presença e ausência do mesmo sintoma",
      "flag": "contradição documental"
    },
    {
      "pattern": "lateralidades divergentes",
      "flag": "contradição de lateralidade"
    }
  ],
  "do_not_infer": [
    "etiologia periférica por sintomas posicionais",
    "etiologia central por desequilíbrio isolado",
    "vertigem a partir de tontura inespecífica",
    "síncope a partir de sensação de desmaio",
    "déficit neurológico ausente quando não mencionado",
    "lateralidade, duração, intensidade, gatilhos ou relação temporal não documentados"
  ],
